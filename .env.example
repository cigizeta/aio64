# Template for .env: copy to .env and fill in. This file is committed;
# .env is not.

# Public base URL of the ngrok tunnel; the MCP endpoint is $PUBLIC_URL/mcp.
PUBLIC_URL=https://<your-domain>.ngrok-free.dev

# Local port that ngrok forwards to (`ngrok http 8000`).
PORT=8000

# Token Claude must send in the X-Api-Key header (connector request header).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AIO64_TOKEN=

# Lichess token, created at lichess.org/account/oauth/token with NO scopes
# (the server refuses tokens with any scope). Its owner is the user whose
# games the Explorer and Games tabs show.
LICHESS_TOKEN=

# Optional Polyglot opening book for the Explorer's Book source. Put the
# .bin in books/ (ignored by Git); relative paths start at the repository.
# POLYGLOT_PATH=books/<book>.bin
