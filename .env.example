# Template for .env: copy to .env and fill in. This file is committed;
# .env is not.

# Public base URL of the ngrok tunnel; the MCP endpoint is $PUBLIC_URL/mcp.
PUBLIC_URL=https://<your-domain>.ngrok-free.dev

# Local port that ngrok forwards to (`ngrok http 8000`).
PORT=8000

# Token Claude must send in the X-Api-Key header (connector request header).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AIO64_TOKEN=

# The accounts whose finished games the server keeps, one SQLite file each
# in games/ (ignored by Git), filled by the sync. Comma-separated; at least
# one account overall. Public data: no token or password needed.
LICHESS_USERS=<lichess-user>
CHESSCOM_USERS=<chesscom-user>

